{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "api-preview",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "audiobookify.api.app:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
